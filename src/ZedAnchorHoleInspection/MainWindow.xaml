<Window x:Class="ZedAnchorHoleInspection.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ZED 2i Anchor Hole Inspection" Width="1500" Height="920"
        MinWidth="1180" MinHeight="720" Background="#0B1016" Foreground="#EAF2F8"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <SolidColorBrush x:Key="Panel" Color="#141C25" />
        <SolidColorBrush x:Key="Line" Color="#293746" />
        <SolidColorBrush x:Key="Accent" Color="#32D6A0" />
        <Style TargetType="Button">
            <Setter Property="Margin" Value="0,4" />
            <Setter Property="Padding" Value="12,9" />
            <Setter Property="Background" Value="#223040" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="#405267" />
        </Style>
        <Style TargetType="ToggleButton">
            <Setter Property="Margin" Value="0,4" />
            <Setter Property="Padding" Value="12,9" />
            <Setter Property="Background" Value="#223040" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="#405267" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Margin" Value="0,3,0,9" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="Background" Value="#0D141C" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="#34475B" />
        </Style>
        <Style TargetType="PasswordBox">
            <Setter Property="Margin" Value="0,3,0,9" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="Background" Value="#0D141C" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="#34475B" />
        </Style>
        <Style TargetType="TextBlock" x:Key="Label">
            <Setter Property="Foreground" Value="#9DB0C2" />
            <Setter Property="FontSize" Value="12" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="66" />
            <RowDefinition Height="*" />
            <RowDefinition Height="34" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#101821" BorderBrush="#293746" BorderThickness="0,0,0,1">
            <Grid Margin="20,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="ZED 2i · ANCHOR HOLE INSPECTION" FontSize="20" FontWeight="SemiBold" />
                    <TextBlock Text="RGB 원형 후보 + 스테레오 XYZ 국소 평면 검증" Foreground="#7F94A8" FontSize="12" />
                </StackPanel>
                <Border Grid.Column="1" Background="#17242C" BorderBrush="#32D6A0" BorderThickness="1"
                        CornerRadius="4" Padding="14,7" VerticalAlignment="Center">
                    <TextBlock x:Name="StateText" Text="IDLE" Foreground="#32D6A0" FontWeight="Bold" />
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="292" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="420" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="5">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="14">
                        <TextBlock Text="CAMERA" FontWeight="Bold" Foreground="#32D6A0" Margin="0,0,0,8" />
                        <Button x:Name="LiveButton" Content="▶ LIVE START" Click="Live_Click" />
                        <ToggleButton x:Name="InspectButton" Content="◎ INSPECTION START" Click="Inspect_Click" />
                        <Button Content="ROI 전체 초기화" Click="ResetRoi_Click" />

                        <Separator Margin="0,14" Background="#334556" />
                        <TextBlock Text="DETECTOR SETTINGS" FontWeight="Bold" Foreground="#32D6A0" Margin="0,0,0,10" />

                        <CheckBox x:Name="UseRoboflowBox" Margin="0,2,0,8" Foreground="#8EC5FF" IsChecked="True"
                                  Content="Roboflow AI 사용" />
                        <TextBlock Style="{StaticResource Label}" Text="모델" />
                        <TextBox Text="hole-detection-fwa4p/2" IsReadOnly="True" />
                        <TextBlock Style="{StaticResource Label}" Text="Roboflow API Key (저장 안 함)" />
                        <PasswordBox x:Name="RoboflowApiKeyBox" />
                        <TextBlock Style="{StaticResource Label}" Text="AI 신뢰도 (0–1)" />
                        <TextBox x:Name="RoboflowConfidenceBox" Text="0.45" />
                        <TextBlock Text="AI 사용 시 선택한 ROI 영상이 Roboflow 서버로 전송됩니다. API Key를 비우면 ROBOFLOW_API_KEY 환경변수를 사용합니다."
                                   TextWrapping="Wrap" Foreground="#E9B96E" FontSize="10" Margin="0,0,0,10" />

                        <CheckBox x:Name="NearRgbOnlyBox" Margin="0,2,0,10" Foreground="#32D6A0" IsChecked="True"
                                  Content="근접 RGB 전용 (300mm 미만, XYZ 없음)" />

                        <TextBlock Style="{StaticResource Label}" Text="최소 홀 반지름 (pixel)" />
                        <TextBox x:Name="MinimumRadiusBox" Text="7" />
                        <TextBlock Style="{StaticResource Label}" Text="최대 홀 반지름 (pixel)" />
                        <TextBox x:Name="MaximumRadiusBox" Text="30" />
                        <TextBlock Style="{StaticResource Label}" Text="최소 암부 대비 (0–255)" />
                        <TextBox x:Name="ContrastBox" Text="12" />
                        <TextBlock Style="{StaticResource Label}" Text="주변 평면 허용 오차 (mm)" />
                        <TextBox x:Name="PlaneToleranceBox" Text="5" />
                        <TextBlock Style="{StaticResource Label}" Text="최소 함몰 깊이 (mm)" />
                        <TextBox x:Name="MinimumDepthBox" Text="6" />
                        <TextBlock Style="{StaticResource Label}" Text="최소 실제 홀 지름 (mm)" />
                        <TextBox x:Name="MinimumDiameterBox" Text="5" />
                        <TextBlock Style="{StaticResource Label}" Text="최대 실제 홀 지름 (mm)" />
                        <TextBox x:Name="MaximumDiameterBox" Text="80" />
                        <TextBlock Style="{StaticResource Label}" Text="3D 모드 최소 측정 거리 (mm)" />
                        <TextBox x:Name="MinimumDistanceBox" Text="300" />
                        <TextBlock Style="{StaticResource Label}" Text="내부 무효점 최소 비율 (0–1)" />
                        <TextBox x:Name="InvalidRatioBox" Text="0.32" />
                        <CheckBox x:Name="AllowVoidOnlyBox" Margin="0,2,0,8" Foreground="#E9B96E" IsChecked="True"
                                  Content="강한 원형+무효 깊이 홀 허용" />
                        <Button Content="설정 적용" Click="ApplySettings_Click" />

                        <Border Margin="0,14,0,0" Padding="10" Background="#0E161E" BorderBrush="#283A4B" BorderThickness="1">
                            <TextBlock TextWrapping="Wrap" Foreground="#8FA4B6" FontSize="11"
                                       Text="100mm 부근에서는 근접 RGB 모드로 픽셀 중심만 검출합니다. XYZ와 실제 지름이 필요하면 근접 모드를 끄고 ZED 2i 깊이 범위인 300mm 이상에서 사용하세요." />
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <Border Grid.Column="2" Background="#05080B" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="5">
                <Grid>
                    <Viewbox Stretch="Uniform">
                        <Grid x:Name="VideoSurface" Width="1280" Height="720"
                              MouseLeftButtonDown="Video_MouseDown"
                              MouseMove="Video_MouseMove"
                              MouseLeftButtonUp="Video_MouseUp">
                            <Image x:Name="CameraImage" Stretch="Fill" />
                            <Canvas x:Name="DetectionLayer" IsHitTestVisible="False" />
                            <Canvas IsHitTestVisible="False">
                                <Rectangle x:Name="RoiRectangle" Width="1280" Height="720"
                                           Stroke="#FFD54F" StrokeThickness="3" StrokeDashArray="8,4"
                                           Fill="#12FFD54F" />
                            </Canvas>
                            <TextBlock x:Name="EmptyLabel" Text="LIVE START를 눌러 ZED 2i에 연결하세요"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="#667887" FontSize="16" IsHitTestVisible="False" />
                        </Grid>
                    </Viewbox>
                </Grid>
            </Border>

            <Border Grid.Column="4" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="5">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Margin="14" Text="DETECTION RESULTS" Foreground="#32D6A0" FontWeight="Bold" />
                    <DataGrid x:Name="ResultGrid" Grid.Row="1" Margin="10,0" AutoGenerateColumns="False"
                              IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column"
                              Background="#101821" Foreground="#EAF2F8" BorderBrush="#293746"
                              RowBackground="#101821" AlternatingRowBackground="#16212B"
                              GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#293746">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="#" Binding="{Binding Id}" Width="35" />
                            <DataGridTextColumn Header="Conf." Binding="{Binding Confidence}" Width="58" />
                            <DataGridTextColumn Header="Ø" Binding="{Binding Diameter}" Width="68" />
                            <DataGridTextColumn Header="Depth" Binding="{Binding Depth}" Width="75" />
                            <DataGridTextColumn Header="X" Binding="{Binding X}" Width="62" />
                            <DataGridTextColumn Header="Y" Binding="{Binding Y}" Width="62" />
                            <DataGridTextColumn Header="Z" Binding="{Binding Z}" Width="62" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <StackPanel Grid.Row="2" Margin="14">
                        <TextBlock x:Name="EvidenceText" Text="검출 결과 없음" Foreground="#8FA4B6" TextWrapping="Wrap" FontSize="11" Margin="0,0,0,6" />
                        <Button Content="현재 결과 CSV 저장" Click="ExportCsv_Click" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="2" Background="#0D141C" BorderBrush="#293746" BorderThickness="0,1,0,0">
            <TextBlock x:Name="FooterText" Margin="14,0" VerticalAlignment="Center" Foreground="#8FA4B6"
                       Text="ZED SDK 준비됨 · 카메라 연결 대기" />
        </Border>
    </Grid>
</Window>
